# Copy this file to .env and fill in the values before deploying.
# Never commit the actual .env file.

# ---- PostgreSQL ----
POSTGRES_USER=codechecker_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=codechecker

# ---- JWT Secret (min 32 random characters) ----
# Generate one with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_minimum_32_character_secret_key

# ---- MinIO Object Storage ----
MINIO_ACCESS_KEY=CHANGE_ME_minio_username
MINIO_SECRET_KEY=CHANGE_ME_minio_password

# ---- CORS ----
# Your public domain — no trailing slash
ALLOWED_ORIGINS=https://yourdomain.com
